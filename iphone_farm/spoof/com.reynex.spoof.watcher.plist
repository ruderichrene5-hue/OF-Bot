<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.reynex.spoof.watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/python3</string>
        <string>/var/jb/usr/local/bin/rnxspoof-watcher</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/var/jb/usr/local/bin:/var/jb/usr/bin:/var/jb/bin:/var/jb/usr/sbin:/var/jb/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/var/log/rnxspoof.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/rnxspoof.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
