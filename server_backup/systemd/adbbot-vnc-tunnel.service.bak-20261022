[Unit]
Description=SSH tunnel server -> Mac mini relay: the iPhones' CatVNC (USB-forwarded 127.0.0.1:5901-5905 there) as 127.0.0.1:15901-15905 here, so /vnc works from https (app.rnx-viewer.com); since 13.10 also WDA 127.0.0.1:810N -> phone :8100 (launchd agents on the Mac get no Local Network permission)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -i /root/.ssh/iphone_farm -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -L 127.0.0.1:15901:127.0.0.1:5901 -L 127.0.0.1:15902:127.0.0.1:5902 -L 127.0.0.1:15903:127.0.0.1:5903 \
  -L 127.0.0.1:15904:127.0.0.1:5904 -L 127.0.0.1:15905:127.0.0.1:5905 -L 127.0.0.1:15906:127.0.0.1:5906 -L 127.0.0.1:15907:127.0.0.1:5907 -L 127.0.0.1:15908:127.0.0.1:5908 \
  -L 127.0.0.1:8101:192.168.1.43:8100 -L 127.0.0.1:8102:192.168.1.49:8100 -L 127.0.0.1:8103:192.168.1.41:8100 -L 127.0.0.1:8104:192.168.1.40:8100 -L 127.0.0.1:8105:192.168.1.42:8100 -L 127.0.0.1:8106:192.168.1.54:8100 -L 127.0.0.1:8107:192.168.1.45:8100 -L 127.0.0.1:8108:192.168.1.53:8100 \
  -L 127.0.0.1:15909:192.168.1.123:5900 -L 127.0.0.1:15910:192.168.1.44:5900 -L 127.0.0.1:15911:192.168.1.47:5900 -L 127.0.0.1:15912:192.168.1.48:5900 -L 127.0.0.1:15913:192.168.1.50:5900 -L 127.0.0.1:8113:192.168.1.50:8100 -L 127.0.0.1:8112:192.168.1.48:8100 -L 127.0.0.1:8111:192.168.1.47:8100 -L 127.0.0.1:8110:192.168.1.44:8100 -L 127.0.0.1:8109:100.86.11.83:8109 \
  -L 127.0.0.1:9101:192.168.1.43:9100 -L 127.0.0.1:9102:192.168.1.49:9100 -L 127.0.0.1:9103:192.168.1.41:9100 -L 127.0.0.1:9104:192.168.1.40:9100 -L 127.0.0.1:9105:192.168.1.42:9100 -L 127.0.0.1:9106:192.168.1.54:9100 -L 127.0.0.1:9107:192.168.1.45:9100 -L 127.0.0.1:9108:192.168.1.53:9100 -L 127.0.0.1:9110:192.168.1.44:9100 -L 127.0.0.1:9111:192.168.1.47:9100 -L 127.0.0.1:9112:192.168.1.48:9100 -L 127.0.0.1:9113:192.168.1.50:9100 reynex03@100.86.11.83
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
