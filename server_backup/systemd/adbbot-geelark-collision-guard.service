[Unit]
Description=ADB bot Geelark collision guard (stops a phone that collides with another on the same proxy port)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/adb_bot
ExecStart=/root/adb_bot/.venv/bin/python -m adb_bot.automation.geelark_collision_guard
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/etc/adbbot/env

[Install]
WantedBy=multi-user.target
