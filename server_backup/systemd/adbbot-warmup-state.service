[Unit]
Description=ADB bot warm-up state publisher (Run Log -> Airtable + MLX tags)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/adb_bot
ExecStart=/root/adb_bot/.venv/bin/python -m adb_bot.automation.run_loop warmup-state --apply
RuntimeMaxSec=7200
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/etc/adbbot/env

[Install]
WantedBy=multi-user.target
