[Unit]
Description=SSH tunnel server -> Mac mini relay. 22.10 (Rene: alles ueber WLAN): every phone by Bonjour name -- CatVNC :5900 -> 127.0.0.1:1590N, WDA :8100 -> 810N, WDA MJPEG :9100 -> 910N. sshd on the Mac resolves <name>.local (launchd agents get no Local Network permission, so no iproxy/socat there). N = stream number (A1 B2 C3 D4 E5 I6 G7 H8 F9 J11 K12 L13).
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -i /root/.ssh/iphone_farm -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
