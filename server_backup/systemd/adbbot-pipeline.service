[Unit]
Description=ADB bot spoofing pipeline (Drive/raw -> Spoof Variants)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/adb_bot
ExecStart=/root/adb_bot/.venv/bin/python -m adb_bot.automation.run_loop pipeline --apply --targets profiles
RuntimeMaxSec=7200
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/etc/adbbot/env

[Install]
WantedBy=multi-user.target
