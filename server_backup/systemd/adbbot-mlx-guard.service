[Unit]
Description=ADB bot MultiLogin guard (stops the fleet when proxy traffic or minutes run out)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/adb_bot
ExecStart=/root/adb_bot/.venv/bin/python -m adb_bot.automation.run_loop mlx-guard --apply
RuntimeMaxSec=7200
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/etc/adbbot/env

[Install]
WantedBy=multi-user.target
